flowchart LR
  subgraph ENTRY["双入口与打开"]
    P["Push"]
    M["站内消息"]
    PC["关闭 Push\n站内消息保留"]
    C["每次打开均重新校验"]
    P -->|"点击"| C
    P -->|"关闭"| PC
    M -->|"查看调整方案"| C
  end

  subgraph VALIDATE["打开校验的全部结果"]
    V{"当前方案是否可用"}
    OK["资格有效\n唯一目标期有效\n页面信息完整"]
    R1["已处理\n已自主换期 / 后台已换期"]
    R2["课程状态变化\n退款 / 转课 / 无听课权限"]
    R3["流程或目标异常\n存在待处理流程 / 目标期失效"]
    R4["无法确认\n资格无法确认 / 信息缺失"]
    R5["技术异常\n请求失败 / 超时"]
    C --> V
    V -->|"可用"| OK
    V -->|"已处理"| R1
    V -->|"课程状态变化"| R2
    V -->|"流程或目标异常"| R3
    V -->|"无法确认"| R4
    V -->|"技术异常"| R5
  end

  subgraph ADJUST["查看与确认"]
    A["调整上课时间\n唯一方案 + 一次限制 + 班主任不变"]
    D["暂不调整\n课程不变 · 消息保留"]
    Q["二次确认弹窗"]
    S["提交中\n禁止重复操作"]
    OK --> A
    A -->|"暂不调整"| D
    A -->|"确认调整"| Q
    Q -->|"我再看看"| A
    Q -->|"确认调整"| S
  end

  subgraph RESULT["提交结果与出口"]
    SU["课程已调整成功"]
    F1["业务或方案问题\n业务拦截 / 方案失效 / 信息缺失"]
    F2["技术或结果问题\n请求失败 / 超时 / 结果不明确"]
    BL["暂时无法在线调整\n不提供在线重试"]
    CAL["学习日历"]
    HOME["首页"]
    TEA["班主任联系入口"]
    SER["统一客服"]
    S -->|"CRM 明确成功"| SU
    S -->|"业务或方案问题"| F1
    S -->|"技术或结果问题"| F2
    SU -->|"查看学习日历"| CAL
    SU -->|"返回首页"| HOME
    F1 --> BL
    F2 --> BL
    R1 --> BL
    R2 --> BL
    R3 --> BL
    R4 --> BL
    R5 --> BL
    BL -->|"联系班主任 · 有有效入口"| TEA
    BL -->|"联系班主任 · 无有效入口"| SER
    BL -->|"返回学习日历"| CAL
  end
